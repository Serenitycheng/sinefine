# Optional: cloud accounts and encrypted DeepSeek connections.
# Street simulation, local saves and preset conversations work without these.
# Copy to .env.local only when connecting your own development Supabase project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FATE_VAULT_SECRET=
# Required only for the opt-in background life scheduler. At least 32 random
# characters; store the same value in Supabase Vault, never a NEXT_PUBLIC var.
FATE_BACKGROUND_CRON_SECRET=
