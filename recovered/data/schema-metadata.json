  "constraints": [
    {
      "conname": "fate_accounts_username_key",
      "contype": "u",
      "table_name": "fate_accounts",
      "definition": "UNIQUE (username)"
    },
    {
      "conname": "fate_accounts_user_id_fkey",
      "contype": "f",
      "table_name": "fate_accounts",
      "definition": "FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE"
    },
    {
      "conname": "fate_accounts_username_check",
      "contype": "c",
      "table_name": "fate_accounts",
      "definition": "CHECK ((username ~ '^[a-z0-9_]{3,32}$'::text))"
    },
    {
      "conname": "fate_accounts_recovery_hash_check",
      "contype": "c",
      "table_name": "fate_accounts",
      "definition": "CHECK ((length(recovery_hash) = 64))"
    },
    {
      "conname": "fate_accounts_pkey",
      "contype": "p",
      "table_name": "fate_accounts",
      "definition": "PRIMARY KEY (user_id)"
    },
    {
      "conname": "fate_connections_encrypted_key_check",
      "contype": "c",
      "table_name": "fate_connections",
      "definition": "CHECK (((length(encrypted_key) >= 20) AND (length(encrypted_key) <= 1024)))"
    },
    {
      "conname": "fate_connections_model_check",
      "contype": "c",
      "table_name": "fate_connections",
      "definition": "CHECK ((model ~ '^[a-zA-Z0-9._:/-]{1,100}$'::text))"
    },
    {
      "conname": "fate_connections_pkey",
      "contype": "p",
      "table_name": "fate_connections",
      "definition": "PRIMARY KEY (user_id)"
    },
    {
      "conname": "fate_connections_user_id_fkey",
      "contype": "f",
      "table_name": "fate_connections",
      "definition": "FOREIGN KEY (user_id) REFERENCES fate_accounts(user_id) ON DELETE CASCADE"
    },
    {
      "conname": "fate_request_limits_pkey",
      "contype": "p",
      "table_name": "fate_request_limits",
